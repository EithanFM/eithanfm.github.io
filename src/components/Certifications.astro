---
import { site } from "../data/site";
import Section from "./Section.astro";

const certificateHref = (file: string) => `${import.meta.env.BASE_URL}certificates/${file}`;
const downloadName = (file: string) => `Eithan-Flores-${file.replace(/\.pdf$/, "")}.pdf`;
---

<Section id="certificates" title="Certificates">
  <div class="space-y-12">
    {
      site.certificateGroups.map((group) => (
        <div>
          <h3 class="font-serif text-2xl font-medium tracking-tight text-navy">{group.heading}</h3>
          <ul class="mt-5 divide-y divide-line border-y border-line">
            {group.items.map((item) => (
              <li class="flex flex-col gap-3 py-4 sm:flex-row sm:items-center sm:justify-between sm:gap-6">
                <div class="min-w-0">
                  <p class="font-medium text-navy text-balance">{item.title}</p>
                  <p class="mt-1 text-sm leading-6 text-ink">{item.issuer} · {item.date}</p>
                </div>
                <div class="flex shrink-0 flex-wrap items-center gap-x-4 gap-y-1">
                  <a
                    href={certificateHref(item.file)}
                    download={downloadName(item.file)}
                    class="inline-flex min-h-11 items-center bg-accent px-4 text-sm font-medium text-white no-underline shadow-card"
                  >
                    Download
                  </a>
                </div>
              </li>
            ))}
          </ul>
        </div>
      ))
    }
  </div>
</Section>
