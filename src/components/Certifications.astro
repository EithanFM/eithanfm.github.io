---
import { site } from "../data/site";
import Section from "./Section.astro";
---

<Section id="certifications" title="Certifications & job simulations">
  <div class="space-y-12">
    {
      site.certificationGroups.map((group) => (
        <div>
          <h3 class="font-serif text-2xl font-medium tracking-tight text-navy">{group.heading}</h3>
          <ul class="mt-5 divide-y divide-line border-y border-line">
            {group.items.map((item) => (
              <li class="py-4 leading-relaxed">{item}</li>
            ))}
          </ul>
        </div>
      ))
    }
  </div>
</Section>
