---
import { site } from "../data/site";

const year = new Date().getFullYear();
---

<footer class="border-t border-line">
  <div class="shell flex flex-col gap-6 py-10 sm:flex-row sm:items-end sm:justify-between">
    <div class="min-w-0">
      <p class="font-serif text-xl tracking-tight text-navy">{site.name}</p>
    </div>
    <div class="flex flex-col items-start gap-2 text-sm sm:items-end">
      <a
        href="#top"
        class="inline-flex min-h-11 items-center -my-3 font-medium text-accent underline decoration-transparent underline-offset-4 transition-colors duration-150 hover:text-navy-soft hover:decoration-accent"
      >
        Back to top
      </a>
      <p class="text-muted">© {year} {site.name}</p>
    </div>
  </div>
</footer>
