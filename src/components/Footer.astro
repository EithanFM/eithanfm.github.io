---
import { site } from "../data/site";

const year = new Date().getFullYear();
---

<footer class="border-t border-line">
  <div class="shell flex flex-col gap-6 py-10 sm:flex-row sm:items-end sm:justify-between">
    <div class="min-w-0">
      <p class="font-serif text-xl tracking-tight text-navy">{site.name}</p>
    </div>
    <div class="flex flex-col items-start gap-2 text-sm sm:items-end">
      <a href="#top" class="font-medium text-navy underline decoration-line underline-offset-4 hover:decoration-navy">
        Back to top
      </a>
      <p class="text-muted">© {year} {site.name}</p>
    </div>
  </div>
</footer>
