---
import { getSite } from "../i18n/content";
import { getUi, type Locale } from "../i18n/ui";
import type { ProjectPage } from "../lib/projects";

interface Props {
  project: ProjectPage;
}

const { project } = Astro.props;
const locale: Locale = Astro.currentLocale === "es" ? "es" : "en";
const site = getSite(locale);
const ui = getUi(locale);
const projectsHref = locale === "es" ? "/es/#projects" : "/#projects";

const linked = site.projects.filter((item) => "href" in item && item.href);
const position = linked.findIndex((item) => "href" in item && item.href === project.href);
const current = position >= 0 ? linked[position] : undefined;
const next = linked.length > 1 ? linked[(position + 1) % linked.length] : undefined;
const category = current
  ? site.projectCategories[current.category as keyof typeof site.projectCategories]
  : undefined;
---

<article class="pb-16 pt-8 sm:pb-24 sm:pt-12">
  <div class="shell">
    <div class="max-w-3xl">
      <a
        href={projectsHref}
        class="group inline-flex min-h-11 items-center gap-2 text-sm font-medium text-accent no-underline"
      >
        <span aria-hidden="true" class="transition-transform duration-200 group-hover:-translate-x-1">←</span>
        {ui.backToProjects}
      </a>
      <div class="mt-4 flex flex-wrap items-center gap-3">
        {
          category ? (
            <span class="enter bg-tint px-2.5 py-1 text-[0.6875rem] font-semibold uppercase tracking-[0.12em] text-accent" style="--i: 0">
              {category}
            </span>
          ) : null
        }
        <span class="enter text-sm text-muted" style="--i: 0">{project.dates}</span>
      </div>
      <h1
        class="enter mt-4 font-serif text-4xl font-semibold leading-tight tracking-tight text-navy text-balance sm:text-5xl"
        style="--i: 1"
      >
        {project.title}
      </h1>
      {
        project.sections.map((section) => (
          <section class="mt-14" data-reveal>
            <h2 class="font-serif text-2xl font-medium tracking-tight text-navy text-balance sm:text-3xl">
              {section.heading}
            </h2>
            <div class="rule mt-4 h-0.5 w-14 bg-accent" aria-hidden="true" />
            <div class="mt-6 max-w-2xl space-y-4 text-base leading-relaxed hyphens-auto text-justify sm:text-lg sm:leading-relaxed">
              {section.paragraphs.map((paragraph) => (
                <p class="text-pretty">{paragraph}</p>
              ))}
            </div>
          </section>
        ))
      }
    </div>

    {
      next && "href" in next ? (
        <a
          href={next.href}
          data-reveal
          class="next group mt-20 flex max-w-3xl items-center justify-between gap-6 border-t-2 border-accent bg-card p-6 text-ink no-underline shadow-card sm:p-8"
        >
          <span class="min-w-0">
            <span class="block text-[0.6875rem] font-semibold uppercase tracking-[0.14em] text-muted">{ui.nextProject}</span>
            <span class="mt-2 block font-serif text-2xl leading-snug text-navy text-balance">{next.title}</span>
          </span>
          <span aria-hidden="true" class="arrow shrink-0 text-2xl text-accent">→</span>
        </a>
      ) : null
    }
  </div>
</article>

<style>
  .next {
    transition:
      box-shadow 0.35s var(--ease-out-strong),
      transform 0.35s var(--ease-out-strong);
  }

  .arrow {
    transition: transform 0.3s var(--ease-out-strong);
  }

  @media (hover: hover) and (prefers-reduced-motion: no-preference) {
    .next:hover {
      transform: translateY(-3px);
      box-shadow: var(--shadow-lift);
    }

    .next:hover .arrow {
      transform: translateX(5px);
    }
  }
</style>
