---
import { getSite } from "../i18n/content";
import { getUi, type Locale } from "../i18n/ui";

const locale: Locale = Astro.currentLocale === "es" ? "es" : "en";
const site = getSite(locale);
const ui = getUi(locale);
---

<section aria-label={ui.highlights} class="bg-navy text-white">
  <ul class="shell grid grid-cols-1 divide-y divide-white/10 sm:grid-cols-2 sm:divide-y-0 lg:grid-cols-4">
    {
      site.highlights.map((item, index) => (
        <li
          data-reveal
          style={`--i: ${index}`}
          class="py-7 sm:px-6 sm:py-10 sm:[&:nth-child(even)]:border-l sm:[&:nth-child(even)]:border-white/10 lg:border-l lg:border-white/10 lg:first:border-l-0 lg:first:pl-0"
        >
          <p class="font-serif text-4xl font-medium tracking-tight tabular-nums sm:text-5xl">{item.value}</p>
          <p class="mt-3 max-w-[16rem] text-sm leading-6 text-white/75">{item.label}</p>
        </li>
      ))
    }
  </ul>
</section>
