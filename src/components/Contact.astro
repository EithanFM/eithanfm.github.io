---
import { getSite } from "../i18n/content";
import { getUi, type Locale } from "../i18n/ui";

const locale: Locale = Astro.currentLocale === "es" ? "es" : "en";
const site = getSite(locale);
const ui = getUi(locale);

const channels = [
  {
    label: ui.linkedin,
    value: site.contact.linkedin.replace(/^https:\/\/www\./, "").replace(/\/$/, ""),
    href: site.contact.linkedin,
    external: true,
  },
  {
    label: ui.email,
    value: site.contact.email,
    href: `mailto:${site.contact.email}`,
    external: false,
  },
];
---

<section id="contact" class="bg-navy py-20 text-white sm:py-28" aria-labelledby="contact-title">
  <div class="shell">
    <div data-reveal>
      <h2 id="contact-title" class="font-serif text-4xl font-medium tracking-tight text-balance sm:text-5xl">
        {ui.contact}
      </h2>
      <div class="rule mt-4 h-0.5 w-14 bg-white/60" aria-hidden="true"></div>
    </div>
    <ul class="mt-12 grid gap-4 sm:grid-cols-2">
      {
        channels.map((channel, index) => (
          <li data-reveal style={`--i: ${index}`} class="min-w-0">
            <a
              href={channel.href}
              class="channel group flex h-full min-w-0 items-center justify-between gap-6 border border-white/15 bg-white/[0.04] p-6 no-underline sm:p-8"
              {...(channel.external ? { target: "_blank", rel: "noopener" } : {})}
            >
              <span class="min-w-0">
                <span class="block text-[0.6875rem] font-semibold uppercase tracking-[0.14em] text-white/60">
                  {channel.label}
                </span>
                <span class="mt-2 block font-serif text-xl leading-snug text-white [overflow-wrap:anywhere] sm:text-2xl">
                  {channel.value}
                </span>
              </span>
              <span aria-hidden="true" class="arrow shrink-0 text-2xl text-white/70">
                {channel.external ? "↗" : "→"}
              </span>
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .channel {
    transition:
      background-color 0.25s ease,
      border-color 0.25s ease;
  }

  .channel:hover {
    background-color: rgb(255 255 255 / 0.09);
    border-color: rgb(255 255 255 / 0.35);
  }

  .arrow {
    transition: transform 0.3s var(--ease-out-strong);
  }

  @media (prefers-reduced-motion: no-preference) {
    .channel:hover .arrow {
      transform: translate(3px, -3px);
    }
  }

  .channel:focus-visible {
    outline-color: #fff;
  }
</style>
