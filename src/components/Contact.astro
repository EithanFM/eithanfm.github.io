---
import { getSite } from "../i18n/content";
import { getUi, type Locale } from "../i18n/ui";
import Section from "./Section.astro";

const locale: Locale = Astro.currentLocale === "es" ? "es" : "en";
const site = getSite(locale);
const ui = getUi(locale);

const channels = [
  {
    label: ui.linkedin,
    value: site.contact.linkedin,
    href: site.contact.linkedin,
    external: true,
  },
  {
    label: ui.email,
    value: site.contact.email,
    href: `mailto:${site.contact.email}`,
    external: false,
  },
];
---

<Section id="contact" title={ui.contact}>
  <dl class="grid gap-10 sm:grid-cols-2">
    {
      channels.map((channel) => (
        <div class="min-w-0">
          <dt class="text-sm font-medium text-navy">{channel.label}</dt>
          <dd class="mt-3 font-serif text-2xl leading-snug [overflow-wrap:anywhere]">
            <a
              href={channel.href}
              class="inline-block min-h-11 py-[5.5px] -my-[5.5px] text-accent underline decoration-accent/35 underline-offset-4 transition-colors duration-150 hover:text-navy-soft hover:decoration-navy-soft"
              {...(channel.external ? { target: "_blank", rel: "noopener" } : {})}
            >
              {channel.value}
            </a>
          </dd>
        </div>
      ))
    }
  </dl>
</Section>
