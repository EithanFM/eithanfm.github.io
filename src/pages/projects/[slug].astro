---
import Base from "../../layouts/Base.astro";
import { projects, type ProjectPage } from "../../lib/projects";

export function getStaticPaths() {
  return projects.map((project) => ({
    params: { slug: project.slug },
    props: { project },
  }));
}

interface Props {
  project: ProjectPage;
}

const { project } = Astro.props;
---

<Base title={project.documentTitle} description={project.description}>
  <article class="py-10 sm:py-16">
    <div class="shell">
      <div class="max-w-3xl">
        <a
          href="/#projects"
          class="inline-flex min-h-11 items-center text-sm font-medium text-accent no-underline underline-offset-4 hover:underline"
        >
          Back to projects
        </a>
        <h1 class="mt-2 font-serif text-4xl font-semibold leading-tight tracking-tight text-navy text-balance sm:text-5xl">
          {project.title}
        </h1>
        <p class="mt-3 text-sm leading-6 text-ink">{project.dates}</p>
        {
          project.sections.map((section) => (
            <section class="mt-12">
              <h2 class="font-serif text-2xl font-medium tracking-tight text-navy text-balance sm:text-3xl">
                {section.heading}
              </h2>
              <div class="mt-4 h-0.5 w-14 bg-accent" aria-hidden="true" />
              <div class="mt-6 max-w-2xl space-y-4 text-base leading-relaxed">
                {section.paragraphs.map((paragraph) => (
                  <p class="text-pretty sm:hyphens-auto sm:text-justify">{paragraph}</p>
                ))}
              </div>
            </section>
          ))
        }
      </div>
    </div>
  </article>
</Base>
