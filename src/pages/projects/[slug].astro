---
import Base from "../../layouts/Base.astro";
import ProjectArticle from "../../components/ProjectArticle.astro";
import { getProjects, type ProjectPage } from "../../lib/projects";

export function getStaticPaths() {
  return getProjects("en").map((project) => ({
    params: { slug: project.slug },
    props: { project },
  }));
}

interface Props {
  project: ProjectPage;
}

const { project } = Astro.props;
---

<Base title={project.documentTitle} description={project.description}>
  <ProjectArticle project={project} />
</Base>
